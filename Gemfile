source "https://rubygems.org"

# Local development only. GitHub Pages builds the site with its own
# pinned toolchain, so this file just needs a Jekyll that renders the
# same templates. Run `bundle exec jekyll serve` to preview.
gem "jekyll", "~> 4.4"

# Only plugins that GitHub Pages also supports.
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-redirect-from", "~> 0.16"
end
